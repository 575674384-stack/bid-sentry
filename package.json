{
  "name": "bid-sentry",
  "version": "0.1.0",
  "description": "Local-first bid document safety assistant",
  "desktopName": "bid-sentry",
  "type": "module",
  "main": "./out/main/index.js",
  "author": "Bid Sentry contributors",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:e2e": "cross-env BID_SENTRY_E2E=1 electron-vite build",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "pnpm typecheck:node && pnpm typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "test": "vitest --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "test:e2e": "pnpm build:e2e && cross-env PLAYWRIGHT_HTML_OPEN=never playwright test",
    "test:e2e:packaged": "cross-env PLAYWRIGHT_HTML_OPEN=never playwright test tests/e2e/packaged.spec.ts",
    "test:e2e:production": "cross-env PLAYWRIGHT_HTML_OPEN=never playwright test tests/e2e/app.spec.ts -g \"launches the packaged production app\"",
    "package:win": "pnpm build && electron-builder --win --x64 --publish never",
    "package:linux": "pnpm build && electron-builder --linux --x64 --publish never",
    "package:e2e:win": "pnpm build:e2e && electron-builder --win --x64 --publish never --config electron-builder.e2e.yml",
    "package:e2e:linux": "pnpm build:e2e && electron-builder --linux --x64 --publish never --config electron-builder.e2e.yml",
    "audit:package": "node scripts/audit-package.mjs",
    "test:ai:live": "node scripts/run-live-ai-test.mjs",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@xmldom/xmldom": "~0.9.10",
    "electron-updater": "6.8.9",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "6.2.108",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "xpath": "0.0.34",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "~1.62.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "cross-env": "10.1.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
